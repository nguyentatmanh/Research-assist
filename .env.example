# Copy to .env; run from the project root. Keys stay in the backend.
RA_DATA_DIR=data
RA_HOST=127.0.0.1
RA_PORT=8000
# demo | gemini | openai | deepseek | ollama
RA_LLM_PROVIDER=demo
RA_LLM_MODEL=
RA_WORKFLOW_PROFILE=balanced
# Optional JSON object; roles inherit the default provider/model.
RA_AGENT_ROUTES={}
RA_GEMINI_API_KEY=
RA_GEMINI_THINKING_LEVEL=low
RA_GEMINI_THINKING_BUDGET=1024
RA_OPENAI_API_KEY=
RA_OPENAI_BASE_URL=https://api.openai.com/v1
RA_DEEPSEEK_API_KEY=
RA_DEEPSEEK_BASE_URL=https://api.deepseek.com
RA_DEEPSEEK_THINKING=false
RA_OLLAMA_BASE_URL=http://localhost:11434/v1
RA_STRUCTURED_OUTPUT=schema
# none | sentence-transformers | openai
RA_EMBEDDING_PROVIDER=none
RA_EMBEDDING_MODEL=intfloat/multilingual-e5-small
RA_EMBEDDING_FAMILY=auto
RA_EMBEDDING_REVISION=
RA_EMBEDDING_MAX_SEQ_LENGTH=512
RA_EMBEDDING_BATCH_SIZE=32
RA_LOCAL_DEVICE=cpu
RA_EMBEDDING_BASE_URL=https://api.openai.com/v1
RA_EMBEDDING_API_KEY=
# Empty disables reranking. Consider a small cross-encoder before BGE on CPU.
RA_RERANKER_MODEL=
RA_RERANK_CANDIDATES=20
RA_SEMANTIC_MIN_SCORE=0.25
RA_CACHE_ENABLED=true
RA_CACHE_TTL_SECONDS=86400
RA_CACHE_MAX_ENTRIES=1000
RA_LLM_MAX_CALLS=12
RA_LLM_MAX_TOTAL_TOKENS=60000
RA_LLM_REQUESTS_PER_MINUTE=20
RA_LLM_MAX_OUTPUT_TOKENS=5000
RA_LLM_TIMEOUT_SECONDS=90
RA_RUN_TIMEOUT_SECONDS=600
RA_MAX_CONCURRENT_RUNS=2
RA_MAX_PENDING_RUNS=12
RA_MAX_UPLOAD_MB=12
RA_MAX_DOCUMENT_CHARS=350000
RA_MAX_PAGES=300
RA_MAX_CHUNKS=20000
# Use tokens after downloading the local tokenizer; chars works in keyless demo.
RA_CHUNK_STRATEGY=chars
RA_CHUNK_CHARS=1600
RA_CHUNK_OVERLAP=180
RA_CHUNK_TOKENS=384
RA_CHUNK_TOKEN_OVERLAP=48
RA_ACCESS_TOKEN=
RA_ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]

# Optional runtime settings.
RA_RERANKER_DEVICE=inherit
RA_RERANKER_BATCH_SIZE=4
RA_RERANKER_MAX_LENGTH=512
RA_RERANKER_FAILURE_POLICY=fallback
RA_SEARCH_CACHE_SCOPES=2
RA_SEARCH_CACHE_MB=128
RA_LLM_MAX_INPUT_CHARS=120000
# Requires Tesseract language data. Runs during ingestion, not on every question.
RA_PDF_OCR_ENABLED=false
RA_PDF_OCR_LANGUAGE=eng
RA_PDF_OCR_DPI=150
RA_PDF_OCR_MAX_PAGES=20
