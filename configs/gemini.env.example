# Copy this file to .env for API + local E5. Follow docs/MODELS.md first.
RA_LLM_PROVIDER=gemini
RA_GEMINI_API_KEY=replace-with-your-key
RA_LLM_MODEL=gemini-3.5-flash-lite
RA_WORKFLOW_PROFILE=balanced
RA_AGENT_ROUTES={"reader":{"model":"gemini-3.5-flash-lite","thinking_level":"minimal"},"summarizer":{"model":"gemini-3.8-flash","thinking_level":"low"},"fact_checker":{"model":"gemini-3.8-flash","thinking_level":"low"}}
RA_EMBEDDING_PROVIDER=sentence-transformers
RA_EMBEDDING_MODEL=models/multilingual-e5-small
RA_EMBEDDING_FAMILY=e5
RA_EMBEDDING_MAX_SEQ_LENGTH=512
RA_LOCAL_DEVICE=cpu
RA_CHUNK_STRATEGY=tokens
RA_CHUNK_TOKENS=384
RA_CHUNK_TOKEN_OVERLAP=48
RA_CACHE_ENABLED=true
RA_LLM_MAX_CALLS=12
RA_LLM_REQUESTS_PER_MINUTE=20
RA_MAX_CONCURRENT_RUNS=1
RA_RERANKER_MODEL=
