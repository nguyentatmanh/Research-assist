# Gemini Free Tier + local E5-base. Merge into .env; preserve existing keys.
# This preset cannot select Google's billing tier. Check Free in AI Studio first.
RA_LLM_PROVIDER=gemini
RA_GEMINI_API_KEY=replace-with-your-key
RA_LLM_MODEL=gemini-3.5-flash-lite
RA_STRUCTURED_OUTPUT=schema
RA_WORKFLOW_PROFILE=balanced
RA_ORCHESTRATION_MODE=autonomous
RA_AGENT_MAX_STEPS=6
RA_AUTONOMOUS_MAX_STEPS=16
RA_AUTONOMOUS_MAX_TASKS=16
RA_GEMINI_THINKING_LEVEL=low
RA_AGENT_ROUTES={"retrieval":{"provider":"gemini","model":"gemini-3.5-flash-lite","thinking_level":"minimal","max_output_tokens":2048},"reader":{"provider":"gemini","model":"gemini-3.5-flash-lite","thinking_level":"low","max_output_tokens":8192},"summarizer":{"provider":"gemini","model":"gemini-3.5-flash-lite","thinking_level":"low","max_output_tokens":8192},"fact_checker":{"provider":"gemini","model":"gemini-3.5-flash-lite","thinking_level":"low","max_output_tokens":8192},"writer":{"provider":"gemini","model":"gemini-3.5-flash-lite","thinking_level":"minimal","max_output_tokens":4096}}
# Initial pacing, not a guarantee of your project's quota. Lower if AI Studio requires it.
RA_LLM_REQUESTS_PER_MINUTE=5
RA_MAX_CONCURRENT_RUNS=1
RA_LLM_MAX_CALLS=24
RA_LLM_MAX_TOTAL_TOKENS=120000
RA_LLM_MAX_OUTPUT_TOKENS=8192
RA_LLM_TIMEOUT_SECONDS=120
RA_RUN_TIMEOUT_SECONDS=900
RA_CACHE_ENABLED=true
# Existing local model on this machine; no embedding API requests.
RA_EMBEDDING_PROVIDER=sentence-transformers
RA_EMBEDDING_MODEL=models/multilingual-e5-base
RA_EMBEDDING_FAMILY=e5
RA_EMBEDDING_MAX_SEQ_LENGTH=512
RA_EMBEDDING_BATCH_SIZE=4
RA_LOCAL_DEVICE=cuda
# Disable external Cohere requests. Hybrid retrieval still works without reranking.
RA_RERANKER_PROVIDER=none
RA_RERANKER_MODEL=
RA_LLM_RETRY_ATTEMPTS=5
RA_LLM_RETRY_INITIAL_SECONDS=5
