# Merge into your WORKING .env. Do not replace provider, model, keys or data/model paths.
RA_WORKFLOW_PROFILE=balanced
RA_MAX_CONCURRENT_RUNS=1
RA_LOCAL_DEVICE=cuda
RA_EMBEDDING_BATCH_SIZE=4
RA_RERANK_CANDIDATES=32
RA_RERANKER_BATCH_SIZE=2
RA_RERANKER_MAX_LENGTH=512
# CPU isolates reranker memory from E5 on a 4 GB GPU; measure speed before choosing.
RA_RERANKER_DEVICE=cpu
RA_RERANKER_FAILURE_POLICY=fallback
RA_CHUNK_STRATEGY=tokens
RA_CHUNK_TOKENS=384
RA_CHUNK_TOKEN_OVERLAP=48
RA_LLM_MAX_CALLS=12
RA_LLM_MAX_TOTAL_TOKENS=60000
# Use rebuild after changing chunk settings. No change to your existing model paths.
