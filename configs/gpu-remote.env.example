# GPU notebook prints the exact URL and checkpoint model ID. Replace existing keys.
RA_EMBEDDING_PROVIDER=remote
RA_EMBEDDING_BASE_URL=https://YOUR-TUNNEL.trycloudflare.com/v1
RA_EMBEDDING_MODEL=research-e5-COPY_THE_CHECKPOINT_ID_FROM_NOTEBOOK
RA_EMBEDDING_API_KEY=PUT_THE_SAME_PRIVATE_KEY_AS_THE_GPU_NOTEBOOK
RA_EMBEDDING_MAX_SEQ_LENGTH=512
RA_EMBEDDING_BATCH_SIZE=16
RA_CHUNK_STRATEGY=tokens
RA_CHUNK_TOKENS=384
RA_CHUNK_TOKEN_OVERLAP=48
RA_CHUNK_TOKENIZER_MODEL=intfloat/multilingual-e5-base

# Local CPU does not run embeddings when provider=remote.
# Keep reasoning LLM settings from your existing .env. No LLM is trained here.
# Reindex when switching checkpoint/provider; a new tunnel URL for the same ID is safe.
